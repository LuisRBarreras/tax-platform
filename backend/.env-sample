# =============================================================================
#  backend/.env — local backend configuration
#
#  This file is the TEMPLATE (no secrets, safe to commit).
#  To use it:
#
#      cp backend/.env-sample backend/.env
#      $EDITOR backend/.env        # fill in the real values
#
#  `backend/.env` is gitignored and must NEVER be committed.
#
#  The backend loads it on startup (python-dotenv, see app/config.py).
#  Priority:  real environment variable  >  backend/.env  >  built-in default
#  So you can try something for one run without editing the file:
#      SMTP_DRY_RUN=0 ./.venv/bin/uvicorn app.main:app
# =============================================================================


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# HTTP port FastAPI listens on.
# Used by: `make api` / uvicorn. The frontend proxies /api to :3000.
# Default: 3000
PORT=3000


# -----------------------------------------------------------------------------
# DATABASE (invoice metadata, MySQL)
# -----------------------------------------------------------------------------

# Connection to the MySQL server. In Docker the host is the `db` service; when
# running locally it is 127.0.0.1 (make db-up starts a matching container).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tax
MYSQL_PASSWORD=taxpass
MYSQL_DATABASE=tax_platform


# -----------------------------------------------------------------------------
# INVOICE PARTIES (printed in the PDF, never captured by the UI)
# -----------------------------------------------------------------------------
# These are intentionally empty in the repository: fill them in your own .env.

# Issuer: who sends the invoice ("From" block).
# INVOICE_ISSUER_NAME=Your Name
# INVOICE_ISSUER_ADDRESS=Street 123\nCity, State 00000\nCountry

# Client: who the invoice is billed to ("Bill to" block).
# INVOICE_CLIENT_NAME=Client Company LLC
# INVOICE_CLIENT_EMAIL=billing@client.example
# INVOICE_CLIENT_ADDRESS=100 Client Street\nCity, State 00000\nTax ID: 00-0000000


# -----------------------------------------------------------------------------
# EMAIL (sending the invoice plus the payment proof)
# -----------------------------------------------------------------------------

# Outgoing SMTP server.
# Used by: where the backend connects to send the email.
# Gmail: smtp.gmail.com with STARTTLS on port 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Account that sends the email (your full Gmail address).
# Used by: SMTP authentication and default sender when MAIL_FROM is empty.
# Example: you@gmail.com
SMTP_USER=

# Gmail app password (16 characters, no spaces).
# IMPORTANT: this is NOT your normal Google password; a regular password fails
#            SMTP login. Generate one at:
#            Google Account > Security > 2-Step Verification > App passwords.
# Without this value (and with SMTP_DRY_RUN=0) sending fails on purpose.
SMTP_PASSWORD=

# Visible sender ("Name <address>").
# Used by: so the recipient sees your name instead of "no-reply@localhost".
# Must match SMTP_USER or Gmail rejects it / flags it as spam.
# Example: "Your Name <you@gmail.com>"
MAIL_FROM=

# Allowed recipients, comma separated.
# Used by: the recipient <select> in the "Send" dialog and the backend check:
#          any other address returns 400, so an invoice cannot be sent to
#          someone who should not receive it.
# Empty means nobody can receive (safe default).
# Example: invoices@your-domain.com,billing@your-domain.com
MAIL_RECIPIENTS=

# Dry-run mode.
#   1 = do NOT send: write the full email to .tmp/outbox/INV-xxx.eml
#       (check the HTML, the table and the attachments without spending sends)
#   0 = really send over SMTP
# Default: 1 (safe: without configuration the app never sends by accident)
SMTP_DRY_RUN=1


# -----------------------------------------------------------------------------
# GOOGLE SHEETS (invoice tracker)
# -----------------------------------------------------------------------------
# Every email that is really sent appends one row to the tab below. The row is
# aligned with the tab's own header row, so extra columns stay empty and the
# column order does not matter.
#
# Requirements:
#   1. Enable "Google Sheets API" in the Google Cloud project of the service
#      account (console.cloud.google.com > APIs & Services > Library).
#   2. Share the spreadsheet with the service account email as Editor.
#   3. Keep the credentials file out of git (it is in .gitignore).
#
# Check everything at once with:  make sheet
#
# Used by: path to the service account JSON, relative to backend/.
# GOOGLE_APPLICATION_CREDENTIALS=resources/service-account-key.json
# Spreadsheet id (the long id in /spreadsheets/d/<id>/edit).
# GOOGLE_SPREADSHEET_ID=
# Required: exact name of the tab that receives the rows (accents included).
# There is no default in the code on purpose: it is always configured here.
GOOGLE_SHEETS_TAB=
# Optional: gid of that tab (the number after #gid= in the URL). When it is set,
# the app resolves the tab by gid and refuses to write if it does not match
# GOOGLE_SHEETS_TAB, so a name/link mix-up cannot send rows to another tab.
GOOGLE_SHEETS_GID=
# 1 = append a row per sent invoice, 0 = disable the integration.
# GOOGLE_SHEETS_ENABLED=1
#
# --- Not used by the current backend -----------------------------------------
# Kept from the old Clojure backend; the template comes from resources/template.
# GOOGLE_DOC_TEMPLATE_ID=
