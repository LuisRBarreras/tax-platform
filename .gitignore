# ============================================================================
#  Local-only assets
# ============================================================================

# The real invoice template is tailored to one client; each install keeps its
# own copy. `invoice.sample.html` is the generic, versioned starting point:
#   make template            (copies the sample when the real one is missing)
backend/resources/template/invoice.html

